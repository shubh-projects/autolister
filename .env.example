# =========================
# Application
# =========================
PORT=8787
PUBLIC_BASE_URL=https://YOUR-HTTPS-TUNNEL.example.com
EXTENSION_ID=YOUR_CHROME_EXTENSION_ID

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=PUT_64_HEX_CHARS_HERE

# Development: true = local fake Flipkart API and fake OAuth connection.
# Production: false
MOCK_FLIPKART=true

# =========================
# Flipkart Third-Party App
# =========================
FLIPKART_CLIENT_ID=
FLIPKART_CLIENT_SECRET=
FLIPKART_SCOPE=Seller_Api
FLIPKART_API_BASE=https://api.flipkart.net/sellers
FLIPKART_OAUTH_BASE=https://api.flipkart.net/oauth-service

# =========================
# AI
# =========================
# ollama is zero-cost/local. Install Ollama and pull a model.
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen3:8b
AI_TIMEOUT_MS=120000

# OCR fallback for scanned PDFs. Set eng or another installed Tesseract language.
OCR_LANG=eng

# Upload protection
MAX_UPLOAD_MB=20

FLIPKART_MAX_RETRIES=3
NODE_ENV=development
